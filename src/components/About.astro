---
import { siteConfig } from "../config";
---

<section id="about" class="theme-section p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold theme-heading"
        >
          About Me
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full accent-bar" />
      </div>

      <div class="lg:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed theme-subheading">
          {siteConfig.aboutMe}
        </p>

        <div class="pt-4 space-y-3 sm:space-y-4">
          {
            siteConfig.skills.map((group) => (
              <p class="text-base sm:text-lg md:text-xl leading-relaxed theme-subheading">
                <span class="font-semibold theme-skill-label">{group.category}:</span>{" "}
                {group.items.join(", ")}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
