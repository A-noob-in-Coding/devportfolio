---
interface TimelineEntry {
  title: string;
  company?: string;
  dateRange?: string;
  bullets?: string[];
}

interface Props {
  id: string;
  title: string;
  entries: TimelineEntry[];
  variant?: "default" | "alt";
}

const { id, title, entries, variant = "default" } = Astro.props;
const hasEntries = entries && entries.length > 0;
const sectionClass =
  variant === "alt" ? "theme-section-alt" : "theme-section";
---

{
  hasEntries && (
    <section id={id} class={`${sectionClass} p-8 sm:p-12 md:p-16 lg:p-24`}>
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold theme-heading">
              {title}
            </h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full accent-bar" />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              {entries.map((exp, index) => (
                <div class="relative mb-12 last:mb-0">
                  <div class="absolute left-1/2 -top-2 w-4 h-4 border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300 border-accent bg-accent" />

                  {index < entries.length - 1 && (
                    <div class="theme-timeline-line absolute left-1/2 bottom-0 w-0.5 h-12 -translate-x-1/2 translate-y-full z-10" />
                  )}

                  <div class="theme-card rounded-lg p-4 sm:p-5 md:p-6 transition-shadow duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold theme-heading">
                          {exp.title}
                        </h3>
                        {exp.company && (
                          <p class="text-base sm:text-lg text-accent">
                            {exp.company}
                          </p>
                        )}
                      </div>
                      {exp.dateRange && (
                        <span class="text-xs sm:text-sm theme-muted mt-2 sm:mt-0">
                          {exp.dateRange}
                        </span>
                      )}
                    </div>

                    {exp.bullets && exp.bullets.length > 0 && (
                      <ul class="space-y-2">
                        {exp.bullets.map((bullet) => (
                          <li class="flex items-start">
                            <span class="theme-bullet inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0" />
                            <span class="text-sm sm:text-base theme-subheading">
                              {bullet}
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
