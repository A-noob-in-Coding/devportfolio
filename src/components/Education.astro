---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="theme-section p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold theme-heading">
              Education
            </h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full accent-bar" />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.education.map((edu) => (
                <div class="theme-card rounded-lg p-4 sm:p-5 md:p-6 transition-shadow duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                    <div>
                      <h3 class="text-lg sm:text-xl font-semibold theme-heading">
                        {edu.degree}
                      </h3>
                      <p class="text-base sm:text-lg text-accent">
                        {edu.school}
                      </p>
                    </div>
                    <span class="text-xs sm:text-sm theme-muted mt-2 sm:mt-0">
                      {edu.dateRange}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
